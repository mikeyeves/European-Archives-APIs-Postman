            "url": {
              "raw": "{{wd_sparql}}?format=json&query=SELECT ?unit ?unitLabel ?start ?end WHERE { wd:{{place_qid}} p:P131 ?st . ?st ps:P131 ?unit . OPTIONAL { ?st pq:P580 ?start } OPTIONAL { ?st pq:P582 ?end } SERVICE wikibase:label { bd:serviceParam wikibase:language \"en,hu,de\". } } ORDER BY ?start",
              "host": [
                "{{wd_sparql}}"
              ],
              "path": [
                ""
              ],
              "query": [
                {
                  "key": "format",
                  "value": "json",
                  "disabled": false,
                  "description": ""
                },
                {
                  "key": "query",
                  "value": "SELECT ?unit ?unitLabel ?start ?end WHERE { wd:{{place_qid}} p:P131 ?st . ?st ps:P131 ?unit . OPTIONAL { ?st pq:P580 ?start } OPTIONAL { ?st pq:P582 ?end } SERVICE wikibase:label { bd:serviceParam wikibase:language \"en,hu,de\". } } ORDER BY ?start",
                  "disabled": false,
                  "description": ""
                }
              ]
            },
            "description": "Which county/state a place belonged to over time (P131 with start/end qualifiers)."
          },
