                  "const cols=[\"unit\",\"unitLabel\",\"start\",\"end\"];",
                  "pm.visualizer.set(`<style>table{border-collapse:collapse;font:13px sans-serif}td,th{border:1px solid #ccc;padding:4px 8px;vertical-align:top}th{background:#eee}</style><p>{{rows.length}} rows</p><table><tr>{{#each cols}}<th>{{this}}</th>{{/each}}</tr>{{#each rows}}<tr>{{#each this}}<td>{{{this}}}</td>{{/each}}</tr>{{/each}}</table>`,{rows:rows.map(r=>cols.map(c=>r[c]==null?'':String(r[c]))),cols});"
                ]
              }
            }
          ]
        },
        {
          "name": "Find a place by its Hungarian/German name (any country)",
          "id": "6aaa3153-ab74-454d-a881-9ac76a82d6e5",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/sparql-results+json"
              }
            ],
            "url": {
              "raw": "{{wd_sparql}}?format=json&query=SELECT ?place ?placeLabel ?hu ?de ?countryLabel WHERE { SERVICE wikibase:mwapi { bd:serviceParam wikibase:endpoint \"www.wikidata.org\"; wikibase:api \"EntitySearch\"; mwapi:search \"{{name_fragment}}\"; mwapi:language \"hu\". ?place wikibase:apiOutputItem mwapi:item. } OPTIONAL { ?place rdfs:label ?hu FILTER(LANG(?hu)=\"hu\") } OPTIONAL { ?place rdfs:label ?de FILTER(LANG(?de)=\"de\") } OPTIONAL { ?place wdt:P17 ?country } SERVICE wikibase:label { bd:serviceParam wikibase:language \"en\". } } LIMIT 30",
              "host": [
                "{{wd_sparql}}"
              ],
              "path": [
                ""
              ],
              "query": [
                {
                  "key": "format",
                  "value": "json",
                  "disabled": false,
                  "description": ""
                },
                {
                  "key": "query",
                  "value": "SELECT ?place ?placeLabel ?hu ?de ?countryLabel WHERE { SERVICE wikibase:mwapi { bd:serviceParam wikibase:endpoint \"www.wikidata.org\"; wikibase:api \"EntitySearch\"; mwapi:search \"{{name_fragment}}\"; mwapi:language \"hu\". ?place wikibase:apiOutputItem mwapi:item. } OPTIONAL { ?place rdfs:label ?hu FILTER(LANG(?hu)=\"hu\") } OPTIONAL { ?place rdfs:label ?de FILTER(LANG(?de)=\"de\") } OPTIONAL { ?place wdt:P17 ?country } SERVICE wikibase:label { bd:serviceParam wikibase:language \"en\". } } LIMIT 30",
                  "disabled": false,
                  "description": ""
                }
              ]
            },
            "description": "Search Wikidata by an old Hungarian or German place name (e.g. Beodra, Nagybecskerek, Werschetz) and get the modern country."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j={};try{j=pm.response.json();}catch(e){}",
                  "const rows=(((j.results||{}).bindings||[]).map(b=>Object.fromEntries(Object.entries(b).map(([k,v])=>[k,v.value]))));",
                  "const cols=[\"place\",\"placeLabel\",\"hu\",\"de\",\"coord\"];",
                  "pm.visualizer.set(`<style>table{border-collapse:collapse;font:13px sans-serif}td,th{border:1px solid #ccc;padding:4px 8px;vertical-align:top}th{background:#eee}</style><p>{{rows.length}} rows</p><table><tr>{{#each cols}}<th>{{this}}</th>{{/each}}</tr>{{#each rows}}<tr>{{#each this}}<td>{{{this}}}</td>{{/each}}</tr>{{/each}}</table>`,{rows:rows.map(r=>cols.map(c=>r[c]==null?'':String(r[c]))),cols});"
                ]
              }
            }
          ]
        },
