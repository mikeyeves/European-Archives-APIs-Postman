{
  "info": {
    "_postman_id": "1a236274-252f-4395-a4ab-0fef02368807",
    "name": "Wikidata (genealogy place-name toolkit)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Wikidata MediaWiki API + SPARQL for resolving historic Central/Eastern European place names (Hungarian ↔ German ↔ Serbian/Romanian/Slovak), administrative history and nearby parishes. No key needed. Please keep the User-Agent descriptive.\n\nSPARQL endpoint: https://query.wikidata.org/sparql"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({key:'User-Agent',value:'GenealogyPostman/1.0 (https://github.com/mikeyeves/European-Archives-APIs-Postman)'});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Entity lookup (MediaWiki API)",
      "id": "a95a0f08-37bd-4141-8262-63c30966ee91",
      "item": [
        {
          "name": "Search entities: Beodra",
          "id": "266ff39b-84d4-49e7-825a-aaf30d85b67e",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{wd_api}}/w/api.php?action=wbsearchentities&search={{search}}&language=en&uselang=en&type=item&limit=20&format=json",
              "host": [
                "{{wd_api}}"
              ],
              "path": [
                "w",
                "api.php"
              ],
              "query": [
                {
                  "key": "action",
                  "value": "wbsearchentities",
                  "disabled": false,
                  "description": ""
                },
                {
                  "key": "search",
                  "value": "{{search}}",
                  "disabled": false,
                  "description": ""
                },
                {
                  "key": "language",
                  "value": "en",
                  "disabled": false,
                  "description": ""
                },
                {
                  "key": "uselang",
                  "value": "en",
                  "disabled": false,
                  "description": ""
                },
                {
                  "key": "type",
                  "value": "item",
                  "disabled": false,
                  "description": ""
                },
                {
                  "key": "limit",
                  "value": "20",
                  "disabled": false,
                  "description": ""
                },
                {
                  "key": "format",
                  "value": "json",
                  "disabled": false,
                  "description": ""
                }
              ]
            },
            "description": "Verified: Beodra → Q12748850 (settlement in Serbia); Novo Miloševo → Q793176."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j={};try{j=pm.response.json();}catch(e){}",
                  "const rows=((j.search||[]).map(s=>({id:'<a href=\"https://www.wikidata.org/wiki/'+s.id+'\">'+s.id+'</a>',label:s.label,description:s.description})));",
                  "const cols=[\"id\",\"label\",\"description\"];",
                  "pm.visualizer.set(`<style>table{border-collapse:collapse;font:13px sans-serif}td,th{border:1px solid #ccc;padding:4px 8px;vertical-align:top}th{background:#eee}</style><p>{{rows.length}} rows</p><table><tr>{{#each cols}}<th>{{this}}</th>{{/each}}</tr>{{#each rows}}<tr>{{#each this}}<td>{{{this}}}</td>{{/each}}</tr>{{/each}}</table>`,{rows:rows.map(r=>cols.map(c=>r[c]==null?'':String(r[c]))),cols});"
                ]
              }
            }
          ]
        },
