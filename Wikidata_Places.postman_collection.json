    {
      "name": "SPARQL (place-name toolkit)",
      "id": "02f47f26-f0e9-40ca-9485-9799d1a6bc1d",
      "item": [
        {
          "name": "Place names in all regional languages",
          "id": "2c09c512-8611-431e-a1d8-ca9c3b8635b3",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/sparql-results+json"
              }
            ],
            "url": {
              "raw": "{{wd_sparql}}?format=json&query=SELECT ?lang ?name WHERE { VALUES ?item { wd:{{place_qid}} } { ?item rdfs:label ?name } UNION { ?item skos:altLabel ?name } BIND(LANG(?name) AS ?lang) FILTER(?lang IN (\"en\",\"hu\",\"de\",\"sr\",\"sr-el\",\"ro\",\"sk\",\"hr\")) } ORDER BY ?lang",
              "host": [
                "{{wd_sparql}}"
              ],
              "path": [
                ""
              ],
              "query": [
                {
                  "key": "format",
                  "value": "json",
                  "disabled": false,
                  "description": ""
                },
                {
                  "key": "query",
                  "value": "SELECT ?lang ?name WHERE { VALUES ?item { wd:{{place_qid}} } { ?item rdfs:label ?name } UNION { ?item skos:altLabel ?name } BIND(LANG(?name) AS ?lang) FILTER(?lang IN (\"en\",\"hu\",\"de\",\"sr\",\"sr-el\",\"ro\",\"sk\",\"hr\")) } ORDER BY ?lang",
                  "disabled": false,
                  "description": ""
                }
              ]
            },
            "description": "Hungarian / German / Serbian / Romanian names for one place."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j={};try{j=pm.response.json();}catch(e){}",
                  "const rows=(((j.results||{}).bindings||[]).map(b=>Object.fromEntries(Object.entries(b).map(([k,v])=>[k,v.value]))));",
                  "const cols=[\"lang\",\"name\"];",
                  "pm.visualizer.set(`<style>table{border-collapse:collapse;font:13px sans-serif}td,th{border:1px solid #ccc;padding:4px 8px;vertical-align:top}th{background:#eee}</style><p>{{rows.length}} rows</p><table><tr>{{#each cols}}<th>{{this}}</th>{{/each}}</tr>{{#each rows}}<tr>{{#each this}}<td>{{{this}}}</td>{{/each}}</tr>{{/each}}</table>`,{rows:rows.map(r=>cols.map(c=>r[c]==null?'':String(r[c]))),cols});"
                ]
              }
            }
          ]
        },
        {
          "name": "Administrative history (county, country, dates)",
          "id": "6eb49923-35e0-4ee3-ae5b-847aa9262a84",
          "request": {
