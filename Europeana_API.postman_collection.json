{
  "info": {
    "_postman_id": "1809fb08-5583-45eb-9b6f-d1b6b251a33b",
    "name": "Europeana API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Europeana APIs (search, record, IIIF, entity, OAI-PMH) for 50M+ items from European archives, libraries and museums — including Europeana Newspapers. Get a free key at https://pro.europeana.eu/pages/get-api and set wskey. The public demo key api2demo works for testing (rate-limited).\n\nDocs: https://pro.europeana.eu/page/apis"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "wskey"
      },
      {
        "key": "value",
        "value": "{{wskey}}"
      },
      {
        "key": "in",
        "value": "query"
      }
    ]
  },
