      "item": [
        {
          "name": "Search (keyword)",
          "id": "d11c7973-ee44-4299-80b6-86841cfef184",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{eu_api}}/record/v2/search.json?query={{query}}&rows=24",
              "host": [
                "{{eu_api}}"
              ],
              "path": [
                "record",
                "v2",
                "search.json"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "{{query}}",
                  "disabled": false,
                  "description": ""
                },
                {
                  "key": "rows",
                  "value": "24",
                  "disabled": false,
                  "description": ""
                },
                {
                  "key": "start",
                  "value": "1",
                  "disabled": true,
                  "description": "1-based offset (max 1000 via start; use cursor beyond)"
                },
                {
                  "key": "cursor",
                  "value": "*",
                  "disabled": true,
                  "description": "Deep paging: * then nextCursor"
                },
                {
                  "key": "profile",
                  "value": "standard",
                  "disabled": true,
                  "description": "minimal | standard | rich | facets | breadcrumbs"
                },
                {
                  "key": "qf",
                  "value": "",
                  "disabled": true,
                  "description": "Filter query, repeatable, e.g. TYPE:TEXT, COUNTRY:hungary, YEAR:[1880 TO 1910]"
                },
                {
                  "key": "reusability",
                  "value": "",
                  "disabled": true,
                  "description": "open | restricted | permission"
                },
                {
                  "key": "media",
                  "value": "",
                  "disabled": true,
                  "description": "true = only items with media"
                },
                {
                  "key": "theme",
                  "value": "",
                  "disabled": true,
                  "description": "e.g. newspaper, photography, maps"
                },
                {
                  "key": "sort",
                  "value": "",
                  "disabled": true,
                  "description": "e.g. score+desc, timestamp_update+desc"
                },
                {
                  "key": "lang",
                  "value": "",
                  "disabled": true,
                  "description": "UI language for labels"
                }
              ]
            },
            "description": "Full-text-style search across 50M+ cultural heritage items. Lucene syntax supported (AND, OR, quotes, field:value)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j={};try{j=pm.response.json();}catch(e){}",
                  "const rows=((j.items||[]).map(i=>({id:'<a href=\"'+(i.guid||'')+'\">'+i.id+'</a>',title:(i.title||[])[0],type:i.type,year:(i.year||[]).join(', '),provider:(i.dataProvider||[])[0],country:(i.country||[]).join(', ')})));",
                  "const cols=[\"id\",\"title\",\"type\",\"year\",\"provider\",\"country\"];",
                  "pm.visualizer.set(`<style>table{border-collapse:collapse;font:13px sans-serif}td,th{border:1px solid #ccc;padding:4px 8px;vertical-align:top}th{background:#eee}</style><p>{{rows.length}} rows</p><table><tr>{{#each cols}}<th>{{this}}</th>{{/each}}</tr>{{#each rows}}<tr>{{#each this}}<td>{{{this}}}</td>{{/each}}</tr>{{/each}}</table>`,{rows:rows.map(r=>cols.map(c=>r[c]==null?'':String(r[c]))),cols});"
                ]
              }
            }
          ]
        },
